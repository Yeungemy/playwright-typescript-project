FROM mcr.microsoft.com/playwright:v1.52.0-jammy

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY --chown=pwuser:pwuser . .

RUN mkdir -p /app/dist/test-report /app/.playwright \
    && chown -R pwuser:pwuser /app

ENV CI=true \
    HEADLESS=true

USER pwuser

CMD ["npm", "run", "ci"]
