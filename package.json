{
    "name": "playwright-framework-project",
    "version": "1.0.0",
    "private": true,
    "description": "Playwright automation framework for UI and API testing",
    "scripts": {
        "test": "playwright test --project=chromium --workers=1 --headed",
        "pretest": "tsc --noEmit",
        "ci": "playwright test --project=chromium --workers=1",
        "test:headed": "playwright test --project=chromium --headed",
        "test:ui": "playwright test --project=chromium --ui",
        "test:e2e": "playwright test src/tests/e2e --project=chromium",
        "test:api": "playwright test src/tests/api --project=chromium",
        "test:smoke": "playwright test --grep @Smoke --project=chromium",
        "test:sanity": "playwright test --grep @Sanity --project=chromium",
        "test:regression": "playwright test --grep @Regression --project=chromium --headed",
        "test:debug": "playwright test --project=chromium --headed --debug",
        "test:flaky": "playwright test --project=chromium --repeat-each=2",
        "allure:install": "npm install --save-dev allure-playwright",
        "allure:clean": "rimraf dist/test-report/allure-results dist/test-report/allure-report",
        "allure:generate": "allure generate dist/test-report/allure-results --clean -o dist/test-report/allure-report",
        "allure:open": "allure open dist/test-report/allure-report",
        "report": "npm run allure:generate && npm run allure:open",
        "test:ci:report": "npm run allure:clean && npm run ci; npm run allure:generate",
        "test:allure": "npm run allure:clean && npm run test && npm run report",
        "test:report:always": "npm run allure:clean && (npm run test || echo Tests failed; exit /b 0) && npm run allure:generate && npm run allure:open",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write ."
    },
    "keywords": [
        "playwright",
        "automation",
        "e2e",
        "api-testing"
    ],
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@types/mssql": "^9.1.7",
        "@types/node": "^22.15.17",
        "@types/winston": "^2.4.4",
        "allure-playwright": "^3.2.2",
        "cross-env": "^7.0.3",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@faker-js/faker": "^9.7.0",
        "@wdio/allure-reporter": "^9.13.0",
        "dotenv": "^16.5.0",
        "mssql": "^11.0.1",
        "zod": "^3.25.20"
    }
}
