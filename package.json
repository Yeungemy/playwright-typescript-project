{
    "name": "playwright-framework-project",
    "version": "1.0.0",
    "private": true,
    "description": "Playwright automation framework for UI, API, and SQL Server testing",
    "scripts": {
        "test": "playwright test --project=chromium",
        "test:cross-browser": "playwright test",
        "typecheck": "tsc --noEmit",
        "pretest": "tsc --noEmit",
        "ci": "npm run typecheck && playwright test --project=chromium",
        "test:e2e": "playwright test src/tests/e2e --project=chromium",
        "test:api": "playwright test src/tests/api --project=chromium",
        "test:database": "playwright test src/tests/database --project=chromium",
        "test:smoke": "playwright test --grep @smoke --project=chromium",
        "test:sanity": "playwright test --grep @sanity --project=chromium",
        "test:regression": "playwright test --project=chromium",
        "test:debug": "playwright test --project=chromium --headed --debug",
        "test:flaky": "playwright test --project=chromium --repeat-each=2",
        "reports:clean": "rimraf dist/test-report",
        "docker:build": "docker compose build playwright",
        "docker:test": "docker compose run --build --rm playwright",
        "test:report": "npm run reports:clean && npm run ci",
        "report:allure:generate": "node scripts/write-allure-environment.mjs && npx --yes allure-commandline@2.34.1 generate dist/test-report/allure-results --clean -o dist/test-report/allure-report",
        "report:allure": "npm run report:allure:generate && npx --yes allure-commandline@2.34.1 open dist/test-report/allure-report",
        "report:html": "playwright show-report dist/test-report/html-report",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "playwright",
        "automation",
        "e2e",
        "api-testing"
    ],
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@types/mssql": "^9.1.7",
        "@types/node": "^22.15.17",
        "allure-playwright": "^3.2.2",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "dotenv": "^16.5.0",
        "mssql": "^11.0.1",
        "zod": "^3.25.20"
    }
}
