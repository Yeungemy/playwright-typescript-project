# Application URL components
ENVIRONMENT=your-test-environment
COM_DOMAIN=example.com
CA_DOMAIN=example.ca
API_DOMAIN=identity-api

# API client credentials (replace with authorized test credentials)
API_CLIENT_ID=
API_PASSWORD=

# Database credentials (only needed for database tests)
DB_HOST=
DB_USER=
DB_PASS=
DB_PRIMARY_Name=${ENVIRONMENT}_Primary
DB_REPORT=${ENVIRONMENT}_report
DB_WAREHOUSE=${ENVIRONMENT}_warehouse

# Playwright settings
CI=false
HEADLESS=true
WORKERS=4
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=15000